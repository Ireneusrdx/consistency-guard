# Consistency Guard — environment configuration
# Copy to server/.env and fill in. NEVER commit real secrets.

# SQLite for local demo (Postgres-compatible schema; switch provider in schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development

# Long random string used to sign JWT session tokens
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Used to encrypt stored provider API keys (AES-256-GCM).
# Accepts a 64-char hex string or any passphrase (SHA-256 derived).
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string-or-strong-passphrase

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: default keys (used only if you want server-wide fallback; per-user credentials are preferred)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# PERPLEXITY_API_KEY=
# LLAMA_BASE_URL=https://api.groq.com/openai/v1
# LLAMA_API_KEY=

# ---------- Production ----------
# Database provider: "sqlite" for local dev, "postgresql" for production.
# The Docker entrypoint switches the Prisma schema automatically.
DB_PROVIDER=sqlite

# Optional: path to a JSON evidence corpus for claim grounding
# (array of {title, url, snippet, sourceType, keywords}).
# Unset → claims are reported unverified; nothing is fabricated.
# A small sample corpus ships at server/data/sample-evidence-corpus.json.
# EVIDENCE_CORPUS_PATH=/app/server/data/sample-evidence-corpus.json

# Optional: override where the server looks for the built client bundle.
# Default is ../../client/dist relative to server/dist.
# CLIENT_DIST=/app/client/dist
